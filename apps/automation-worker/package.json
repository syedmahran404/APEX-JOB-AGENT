{
  "name": "@apex/automation-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test:unit": "vitest --run",
    "test:integration": "RUN_INTEGRATION=1 vitest --run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@apex/automation-core": "workspace:^",
    "@apex/platform-adapter-linkedin": "workspace:^",
    "@apex/queue": "workspace:^",
    "@apex/shared-config": "workspace:^",
    "@apex/shared-errors": "workspace:^",
    "@apex/shared-events": "workspace:^",
    "@apex/shared-logger": "workspace:^",
    "@apex/shared-types": "workspace:^",
    "@apex/vault-client": "workspace:^",
    "playwright-core": "^1.47.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
