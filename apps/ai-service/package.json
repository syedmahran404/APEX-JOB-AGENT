{
  "name": "@apex/ai-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest --run",
    "test:integration": "RUN_INTEGRATION=1 vitest --run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@apex/ai-core": "workspace:^",
    "@apex/db": "workspace:^",
    "@apex/shared-config": "workspace:^",
    "@apex/shared-errors": "workspace:^",
    "@apex/shared-logger": "workspace:^",
    "@apex/shared-types": "workspace:^",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
