{
  "name": "@apex/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest --run",
    "test:integration": "RUN_INTEGRATION=1 vitest --run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@apex/crypto": "workspace:^",
    "@apex/db": "workspace:^",
    "@apex/queue": "workspace:^",
    "@apex/realtime": "workspace:^",
    "@apex/shared-config": "workspace:^",
    "@apex/shared-errors": "workspace:^",
    "@apex/shared-events": "workspace:^",
    "@apex/shared-logger": "workspace:^",
    "@apex/shared-types": "workspace:^",
    "@apex/vault-client": "workspace:^",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@testcontainers/postgresql": "^10.13.1",
    "@vitest/coverage-v8": "^2.1.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
