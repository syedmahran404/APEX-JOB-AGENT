# Apex Job Agent — example environment file.
# Copy to `.env` for local dev only. Production values are loaded from Vault at boot.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Databases ---
DATABASE_URL=postgres://apex:apex@localhost:5432/apex
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_RESUMES=apex-resumes
S3_BUCKET_SCREENSHOTS=apex-screenshots
S3_BUCKET_COVER_LETTERS=apex-cover-letters
S3_BUCKET_STORAGE_STATE=apex-storage-state
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Vault (dev profile) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# --- Auth ---
SESSION_COOKIE_DOMAIN=localhost
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Apex Job Agent (dev)

# --- AI providers (optional in dev — MOCK is used when unset) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Cost governor (defaults; overridable per user) ---
AI_DAILY_CEILING_USD=0.50
AI_BURST_RPM=60
AI_BURST_RPH=600

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=apex-api
